    "light": "/docs/logo/light.svg",
    "dark": "/docs/logo/dark.svg",
    "href": "https://crust.moumen.dev/"
  },
  "appearance": {
    "default": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/moumen-soliman/crust"
      }
