        "pages": [
          "docs/guides/ci",
          "docs/guides/monorepos",
          "docs/guides/widget",
          "docs/guides/runtime",
          "docs/guides/staging"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "docs/reference/cli",
          "docs/reference/budgets",
          "docs/reference/files"
        ]
      },
      {
        "group": "Support",
        "pages": [
          "docs/support"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/moumen-soliman/crust"
    }
  }
